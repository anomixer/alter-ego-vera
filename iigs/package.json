{
    "name":  "silky-gs",
    "version":  "1.0.0",
    "description":  "A hardware abstraction layer runtime for porting NES games to the Apple IIgs",
    "main":  "index.js",
    "config":  {
                   "merlin32":  "C:\\dev\\Merlin32.exe",
                   "cadius":  "C:\\dev\\cadius.exe",
                   "gsport":  "C:\\Programs\\gsport\\gsport_0.31\\GSPort.exe",
                   "macros":  ".",
                   "crossrunner":  "C:\\checkout\\Crossrunner\\Crossrunner.exe",
                   "cyrene":  "C:\\Programs\\IIgsXDev\\bin\\Cyrene-1.1.0.exe",
                   "kegscyrene":  "C:\\Programs\\IIgsXDev\\bin\\KegsCyrene-1.1.0.exe",
                   "mame":  "C:\\Programs\\MAME\\MAME-0.288\\mame.exe",
                   "mameArgs":  "apple2gs -window -nomax -skip_gameinfo -nofilter -snapsize 704x462 -ramsize 4M"
               },
    "scripts":  {
                    "gsport":  "%npm_package_config_gsport%",
                    "kegs":  "%npm_package_config_kegscyrene%",
                    "cr":  "%npm_package_config_crossrunner%",
                    "test":  "vitest run --config vitest.config.mjs",
                    "run":  "npm run build-image \u0026\u0026 %npm_package_config_gsport%",
                    "build:all":  "npm run build:smb \u0026\u0026 npm run build:bf \u0026\u0026 npm run build:wump \u0026\u0026 npm run build:lo \u0026\u0026 npm run build:ic \u0026\u0026 npm run build:eb \u0026\u0026 npm run build:dk \u0026\u0026 npm run build:mb \u0026\u0026 npm run build:zelda \u0026\u0026 npm run build:contra",
                    "build:smb":  "node ./src/games/smb/build.js",
                    "build:bf":  "node ./src/games/bf/build.js",
                    "build:contra":  "node ./src/games/contra/build.js",
                    "build:tetris":  "node ./src/games/tg-tetris/build.js",
                    "build:wump":  "node ./src/games/wumpus/build.js",
                    "build:lo":  "node ./src/games/lightsout/build.js",
                    "build:ic":  "node ./src/games/iceclimber/build.js",
                    "build:eb":  "node ./src/games/excitebike/build.js",
                    "build:dk":  "node ./src/games/dk/build.js",
                    "build:mb":  "node ./src/games/mb/build.js",
                    "build:zelda":  "node ./src/games/zelda/build.js",
                    "build:bench":  "node ./src/games/bench/build.js",
                    "debug:smb":  "cd src/games/smb \u0026\u0026 %npm_package_config_crossrunner% SuperMarioGS -source SuperMarioGS_S02__Output.txt -map SMB.s -Debug -CompatibilityLayer",
                    "debug:bf":  "cd src/games/bf \u0026\u0026 %npm_package_config_crossrunner% BalloonFgtGS -source BalloonFgtGS_S02__Output.txt -map BF.s -Debug -CompatibilityLayer",
                    "debug:lo":  "cd src/games/lightsout \u0026\u0026 %npm_package_config_crossrunner% LightsOutGS -source LightsOutGS_S02__Output.txt LightsOutGS_S03__Output.txt LightsOutGS_S04__Output.txt LightsOutGS_S05__Output.txt LightsOutGS_S06__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "debug:wump":  "cd src/games/wumpus \u0026\u0026 %npm_package_config_crossrunner% WumpusGS -source WumpusGS_S02__Output.txt WumpusGS_S03__Output.txt WumpusGS_S04__Output.txt WumpusGS_S05__Output.txt -map Wump.s -Debug -CompatibilityLayer",
                    "debug:eb":  "cd src/games/excitebike \u0026\u0026 %npm_package_config_crossrunner% ExciteBikeGS -source ExciteBikeGS_S02__Output.txt ExciteBikeGS_S03__Output.txt ExciteBikeGS_S04__Output.txt ExciteBikeGS_S05__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "debug:dk":  "cd src/games/dk \u0026\u0026 %npm_package_config_crossrunner% DonkeyKongGS -source DonkeyKongGS_S02__Output.txt DonkeyKongGS_S03__Output.txt DonkeyKongGS_S04__Output.txt DonkeyKongGS_S05__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "debug:ic":  "cd src/games/iceclimber \u0026\u0026 %npm_package_config_crossrunner% IceClimberGS -source IceClimberGS_S02__Output.txt IceClimberGS_S03__Output.txt IceClimberGS_S04__Output.txt IceClimberGS_S05__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "debug:mb":  "cd src/games/mb \u0026\u0026 %npm_package_config_crossrunner% MarioBrosGS -source MarioBrosGS_S02__Output.txt MarioBrosGS_S03__Output.txt MarioBrosGS_S04__Output.txt MarioBrosGS_S05__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "debug:zelda":  "cd src/games/zelda/src \u0026\u0026 %npm_package_config_crossrunner% ZeldaGS -source ZeldaGS_S02__Output.txt ZeldaGS_S03__Output.txt ZeldaGS_S04__Output.txt ZeldaGS_S05__Output.txt -map Master.s -Debug -CompatibilityLayer",
                    "cyrene:bf":  "npm run build-image \u0026\u0026 concurrently \u0027%npm_package_config_cyrene%\u0027 \u0027%npm_package_config_kegscyrene%\u0027",
                    "build-image":  ".\\build-image.bat %npm_package_config_cadius% .\\emu\\Target.2mg /ClassicsGS/",
                    "build-image:smb":  ".\\build-single.bat %npm_package_config_cadius% smb",
                    "build-image:bf":  ".\\build-single.bat %npm_package_config_cadius% bf",
                    "build-image:lo":  ".\\build-single.bat %npm_package_config_cadius% lo",
                    "build-image:wump":  ".\\build-single.bat %npm_package_config_cadius% wump",
                    "build-image:ic":  ".\\build-single.bat %npm_package_config_cadius% ic",
                    "build-image:eb":  ".\\build-single.bat %npm_package_config_cadius% eb",
                    "build-image:dk":  ".\\build-single.bat %npm_package_config_cadius% dk",
                    "build-image:mb":  ".\\build-single.bat %npm_package_config_cadius% mb",
                    "build-image:zelda":  ".\\build-single.bat %npm_package_config_cadius% zelda",
                    "build-image:contra":  ".\\build-single.bat %npm_package_config_cadius% contra",
                    "build-image:tetris":  ".\\build-single.bat %npm_package_config_cadius% tetris",
                    "build-image:bench":  ".\\build-single.bat %npm_package_config_cadius% bench",
                    "build:dist":  ".\\build-single.bat %npm_package_config_cadius%",
                    "gen-includes":  "node scripts/gen-includes.js",
                    "bench":  "node scripts/run-bench.js",
                    "test:unit":  "vitest run --config vitest.config.mjs",
                    "test:unit:watch":  "vitest --config vitest.config.mjs"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/lscharen/iigs-game-engine.git"
                   },
    "author":  "Lucas Scharenbroich",
    "license":  "Apache-2.0",
    "bugs":  {
                 "url":  "https://github.com/lscharen/iigs-game-engine/issues"
             },
    "homepage":  "https://github.com/lscharen/iigs-game-engine#readme",
    "devDependencies":  {
                            "concurrently":  "^9.1.2",
                            "csv-parse":  "^5.5.6",
                            "dotenv":  "^17.4.2",
                            "iigs-unit":  "file:../iigs-unit",
                            "pngjs":  "^6.0.0",
                            "string-builder":  "^0.1.8",
                            "vitest":  "^2.0.0",
                            "watch":  "latest",
                            "xml2json":  "^0.12.0"
                        }
}
